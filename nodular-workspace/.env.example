# Everything is optional: with no keys the app runs locally with mocks, sharp upscaling and SQLite.
# HF_TOKEN is the free Hugging Face key for the image chain below (and is not required).
GROQ_API_KEY=
HF_TOKEN=
# Paid. The upscaler calls Replicate when this is set, and falls back to sharp.
# The same value is the key for the opt-in "replicate" image provider, which stays off
# unless IMAGE_PROVIDERS lists replicate.
REPLICATE_API_TOKEN=

# Persistence: SQLite in DATA_DIR by default; set both to use Supabase (run supabase/schema.sql first)
DATA_DIR=./data
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Auth (Clerk). When CLERK_SECRET_KEY is set every /api route needs a signed-in user.
# When it is unset the server still starts (local dev), but it listens on 0.0.0.0
# and every /api route is open, including minting MCP access tokens and OAuth clients.
# Set this before exposing the port.
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Billing (Stripe metered usage)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_METER_EVENT_NAME=
FREE_CREDITS=100

PUBLIC_URL=                     # e.g. https://yourapp.fly.dev (used in the deploy curl)
CORS_ORIGIN=                    # comma-separated; default allows all

# Agents (self-hosted LLM router; free first)
# Provider order; Ollama first, then Groq, then any OpenAI-compatible endpoint. "none" forces the offline mock.
LLM_PROVIDERS=ollama,groq,openai
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_BASIC_AUTH=              # user:pass if your VPS proxy requires it
OLLAMA_MODEL=                   # default: first model reported by /api/tags
GROQ_API_KEY=
GROQ_MODEL=
# OpenAI-compatible chat completions (server/agent/llm.ts, provider "openai").
# The provider is on only when both OPENAI_BASE_URL and OPENAI_API_KEY are set.
# A blank OPENAI_MODEL falls back to gpt-4o-mini.
#
# xAI Grok uses this same path. Leave the three assignments below blank.
# Copy them into .env and set them there, for example:
#   OPENAI_BASE_URL=https://api.x.ai/v1
#   OPENAI_API_KEY=<key from https://console.x.ai>
#   OPENAI_MODEL=grok-4.7
# The server does not read XAI_API_KEY, so that name is not listed here.
# OPENAI_API_KEY is not used for images unless IMAGE_PROVIDERS lists openai (paid, see below).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Image generation (free first) ---
# Order of still-image providers for generate_image, POST /api/flux, and flux workflow nodes.
# Unset uses: huggingface, gemini, pollinations, local
# A name is skipped until its setting is present, except pollinations (no key).
# IMAGE_PROVIDERS=none (or a blank value) skips the network and returns an SVG placeholder.
# If every provider that was actually called fails, the API returns an error naming each one.
# OpenAI and Replicate bill per image. They are never called unless listed here AND their key is set.
# A key that is only set, with the name left out of this list, does nothing for images.
# IMAGE_PROVIDERS=huggingface,gemini,pollinations,local
IMAGE_PROVIDERS=

# FREE with a Hugging Face access token (Inference Providers). Uses HF_TOKEN above.
# Tries FLUX.1-schnell, then SDXL, on router.huggingface.co. Override with one id or a comma list.
# HF_IMAGE_MODEL=
# HF_IMAGE_MODELS=black-forest-labs/FLUX.1-schnell,stabilityai/stable-diffusion-xl-base-1.0

# Gemini image ("Nano Banana", model gemini-2.5-flash-image). Called only when this key is set.
# Google's pricing page currently lists no free tier for that model, so a key can bill per image.
# Leave it blank to stay on the no-cost path. A quota or billing error is logged and the next provider runs.
# https://ai.google.dev/gemini-api/docs/pricing
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Pollinations classic image API (https://image.pollinations.ai) needs no key.
# It is in the default order. Anonymous use is rate-limited, and the prompt is sent to that service.
# Remove pollinations from IMAGE_PROVIDERS to turn it off.

# Local / self-hosted. Used only when LOCAL_IMAGE_URL is set. No cloud bill.
# LOCAL_IMAGE_KIND:
#   a1111   Automatic1111 or SD.Next: POST {url}/sdapi/v1/txt2img   (default)
#   comfy   ComfyUI: POST {url}/prompt, then /history and /view. Checkpoint: COMFY_CHECKPOINT
#   openai  Local OpenAI-compatible POST {url}/v1/images/generations (an Ollama-adjacent proxy).
#           This is not api.openai.com. Stock Ollama does not generate images.
#   ollama  Same local OpenAI-compatible images endpoint as openai.
LOCAL_IMAGE_URL=
# LOCAL_IMAGE_KIND=a1111
# LOCAL_IMAGE_TOKEN=
# COMFY_CHECKPOINT=sd_xl_base_1.0.safetensors

# PAID, opt-in. Ignored unless IMAGE_PROVIDERS includes the name AND the key is set.
# Image calls go to api.openai.com (or OPENAI_IMAGE_BASE_URL). They do not use OPENAI_BASE_URL,
# so an xAI chat setup is not an image call.
# OPENAI_IMAGE_MODEL defaults to gpt-image-1, which OpenAI gates on organization verification
# and which bills per image. dall-e-3 is accepted if you set it.
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
# REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

SEARXNG_URL=                    # optional; web_search falls back to DuckDuckGo
ALLOW_PRIVATE_FETCH=            # set 1 to let http_get reach private/LAN addresses
HTTP_TOOLS_FILE=                # default config/http-tools.json
FRAYNIX_ENGINE_URL=
FRAYNIX_ENGINE_TOKEN=
HERMES_URL=
HERMES_TOKEN=
TTS_URL=

# Code-drawn explainer (workflows/code-explainer-60s). All optional; leave blank to keep the stubs unregistered.
# Word-level TTS. Guessed ElevenLabs template. The tool stays off until all three are set.
# VoiceStudio (VOICESTUDIO_MCP_URL above) is the free-first narration path; word timings count only if that tool's result includes them.
ELEVENLABS_API_KEY=
ELEVENLABS_API_URL=
ELEVENLABS_VOICE_ID=
# Remote asset store stub. asset_lookup is the free catalog and ships placeholders only.
ASSET_LIBRARY_URL=
ASSET_LIBRARY_TOKEN=
# Optional paid realism pass. Guessed prediction URL (Replicate or another host you trust). Off until both are set.
REALISM_PREDICT_URL=

# --- Media skills (all optional; see README 'Media skills') ---
VOICESTUDIO_MCP_URL=           # e.g. http://127.0.0.1:3900/mcp/ (VoiceStudio, AGPL-3.0)
PHOTOCRAFT_CLI=                # absolute path to photocraft-cli binary (runs 'photocraft-cli mcp')
REA_MCP=                       # set to 1 to enable Reverse Engineer Anything MCP via npx
MCP_SERVERS_FILE=              # override ./config/mcp-servers.json

# --- Agent hub ---
MCP_ADMIN_TOKEN=               # 24+ chars: static full-admin bearer for /mcp (headless VPS use)
# User id that bearer acts as. If set, this id is also an app owner (see below).
# Leave blank to keep the token's principal as "local". Runs that present MCP_ADMIN_TOKEN
# are still treated as the owner; other open-mode requests are not. Do not set this to
# "local" unless every open-mode caller should skip tool approval.
MCP_ADMIN_USER=
ALLOW_STDIO_IMPORT=            # set 1 to let the UI/MCP import local-command MCP servers (runs code on this host)
AGENTS_DIR=                    # default ./agents

# App owner. These user ids skip approval prompts on their own agent runs and on
# agents they delegate to (including hyperframes_render). Use Clerk user ids
# (the JWT sub, e.g. user_...). Comma or whitespace separated. Leave blank to
# require approval for everyone.
# The open-mode user id "local" (CLERK_SECRET_KEY unset) is NOT an owner unless
# you list it. Listing "local" auto-approves every open-mode request.
# Other signed-in users, anonymous requests, and unattended automations stay gated.
OWNER_USER_IDS=
OWNER_USER_ID=                 # single-id alias of OWNER_USER_IDS
# Comma-separated emails. A signed-in Clerk user (id user_...) is also an owner
# when one of these matches an email Clerk has verified for them. Comparison is
# case-insensitive. The default session JWT does not include email; the server
# loads verified addresses from the Clerk Backend API with CLERK_SECRET_KEY and
# caches them briefly. Unverified or missing emails never match. Leave blank to
# disable. Do not put a real address in this file.
OWNER_EMAILS=

# Set to off to disable the cron scheduler
# SCHEDULER=off
