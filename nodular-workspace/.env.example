# Everything is optional: with no keys the app runs locally with mocks, sharp upscaling and SQLite.
GROQ_API_KEY=
HF_TOKEN=
REPLICATE_API_TOKEN=            # optional: true Real-ESRGAN upscaling (falls back to sharp)

# Persistence: SQLite in DATA_DIR by default; set both to use Supabase (run supabase/schema.sql first)
DATA_DIR=./data
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Auth (Clerk). When CLERK_SECRET_KEY is set every /api route needs a signed-in user.
# When it is unset the server still starts (local dev), but it listens on 0.0.0.0
# and every /api route is open, including minting MCP access tokens and OAuth clients.
# Set this before exposing the port.
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Billing (Stripe metered usage)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_METER_EVENT_NAME=
FREE_CREDITS=100

PUBLIC_URL=                     # e.g. https://yourapp.fly.dev (used in the deploy curl)
CORS_ORIGIN=                    # comma-separated; default allows all

# Agents (self-hosted LLM router; free first)
# Provider order; Ollama first, then Groq, then any OpenAI-compatible endpoint. "none" forces the offline mock.
LLM_PROVIDERS=ollama,groq,openai
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_BASIC_AUTH=              # user:pass if your VPS proxy requires it
OLLAMA_MODEL=                   # default: first model reported by /api/tags
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
SEARXNG_URL=                    # optional; web_search falls back to DuckDuckGo
ALLOW_PRIVATE_FETCH=            # set 1 to let http_get reach private/LAN addresses
HTTP_TOOLS_FILE=                # default config/http-tools.json
FRAYNIX_ENGINE_URL=
FRAYNIX_ENGINE_TOKEN=
HERMES_URL=
HERMES_TOKEN=
TTS_URL=

# Code-drawn explainer (workflows/code-explainer-60s). All optional; leave blank to keep the stubs unregistered.
# Word-level TTS. Guessed ElevenLabs template. The tool stays off until all three are set.
# VoiceStudio (VOICESTUDIO_MCP_URL above) is the free-first narration path; word timings count only if that tool's result includes them.
ELEVENLABS_API_KEY=
ELEVENLABS_API_URL=
ELEVENLABS_VOICE_ID=
# Remote asset store stub. asset_lookup is the free catalog and ships placeholders only.
ASSET_LIBRARY_URL=
ASSET_LIBRARY_TOKEN=
# Optional paid realism pass. Guessed prediction URL (Replicate or another host you trust). Off until both are set.
REALISM_PREDICT_URL=

# --- Media skills (all optional; see README 'Media skills') ---
VOICESTUDIO_MCP_URL=           # e.g. http://127.0.0.1:3900/mcp/ (VoiceStudio, AGPL-3.0)
PHOTOCRAFT_CLI=                # absolute path to photocraft-cli binary (runs 'photocraft-cli mcp')
REA_MCP=                       # set to 1 to enable Reverse Engineer Anything MCP via npx
MCP_SERVERS_FILE=              # override ./config/mcp-servers.json

# --- Agent hub ---
MCP_ADMIN_TOKEN=               # 24+ chars: static full-admin bearer for /mcp (headless VPS use)
ALLOW_STDIO_IMPORT=            # set 1 to let the UI/MCP import local-command MCP servers (runs code on this host)
AGENTS_DIR=                    # default ./agents

# Set to off to disable the cron scheduler
# SCHEDULER=off
